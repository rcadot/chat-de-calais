# Copier ce fichier en .env puis renseigner la clé.
# Les variables commentées prennent leur valeur par défaut (config.py).

# API Albert (https://albert.api.etalab.gouv.fr/), obligatoire
ALBERT_API_KEY=

# Mode de prompt par défaut : administratif | technique | créatif
PROMPT_MODE=administratif

# OCR des PDF scannés et des images
# OCR_ENABLED=true
# Moteur : openweight (accès ouvert) | mistral (accès restreint, repli automatique)
# OCR_ENGINE=openweight
# OCR des images insérées dans les pages de texte (PDF mixtes)
# OCR_IMAGES_IN_TEXT_PAGES=true

# Recherche hybride vectorielle + mots-clés (BM25)
# USE_HYBRID_SEARCH=true

# Prompts personnalisés (remplacent ceux du mode ; variables {context} et {query})
# CUSTOM_SYSTEM_PROMPT=
# CUSTOM_RAG_PROMPT=
# CUSTOM_HYDE_PROMPT=
